---
import { Icon } from "astro-iconset/components";
// Worker env (vars + secrets). The Cloudflare adapter runs dev and production
// in workerd, so this resolves in both.
import { env } from "cloudflare:workers";
import { getEmDashEntry } from "emdash";
import { WorkerMailer } from "worker-mailer";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");

// `cache.set` only applies to GET responses; wrap defensively because
// this route also handles POST submissions where the cache API may
// reject the call.
try {
	Astro.cache.set(cacheHint);
} catch {}

/*
 * Form submissions are emailed through Gmail SMTP submission (STARTTLS on
 * 587 -- Workers only block outbound port 25), authenticating as the
 * Workspace mailbox with an app password. Google already publishes SPF and
 * DKIM for this domain, so nothing extra is needed to pass authentication.
 *
 * The message is sent from the mailbox to itself with Reply-To set to the
 * submitter, so replying from the inbox goes straight back to them. Sending
 * *as* the visitor's address would fail SPF/DMARC on their domain.
 */
const INBOX = "hello@storyandmeasure.com";
const SMTP_HOST = "smtp.gmail.com";
const SMTP_PORT = 587;

// Caps stop a bot from posting megabytes of junk into the inbox.
const LIMITS = { name: 120, email: 200, company: 160, message: 5000 };
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

let formStatus: "idle" | "success" | "error" = "idle";
let formMessage = "";

const SUCCESS_MESSAGE =
	"Thanks for reaching out! You'll hear back within one business day.";

if (Astro.request.method === "POST") {
	try {
		const formData = await Astro.request.formData();
		const field = (key: string, max: number) =>
			(formData.get(key)?.toString() ?? "").trim().slice(0, max);

		const name = field("name", LIMITS.name);
		const email = field("email", LIMITS.email);
		const company = field("company", LIMITS.company);
		const message = field("message", LIMITS.message);
		// Honeypot: hidden from people, irresistible to bots. A filled value
		// gets the success screen so the bot has nothing to learn from.
		const trap = formData.get("website")?.toString() ?? "";

		if (trap) {
			formStatus = "success";
			formMessage = SUCCESS_MESSAGE;
		} else if (!name || !email || !message) {
			formStatus = "error";
			formMessage = "Please fill in all required fields.";
		} else if (!EMAIL_PATTERN.test(email)) {
			formStatus = "error";
			formMessage = "Please enter a valid email address.";
		} else {
			const lines = [
				`Name:    ${name}`,
				`Email:   ${email}`,
				company ? `Company: ${company}` : null,
				"",
				message,
			].filter((line) => line !== null);

			const appPassword = env.GMAIL_APP_PASSWORD;
			const subject = `Contact form: ${name}${company ? ` (${company})` : ""}`;

			if (!appPassword) {
				// Keep the flow testable locally without putting a live
				// credential in .dev.vars -- but never claim delivery in
				// production when the secret is missing.
				if (import.meta.env.DEV) {
					console.log(`[contact] (dev, not sent) ${subject}\n${lines.join("\n")}`);
					formStatus = "success";
					formMessage = SUCCESS_MESSAGE;
				} else {
					throw new Error("GMAIL_APP_PASSWORD is not set");
				}
			} else {
				await WorkerMailer.send(
					{
						host: SMTP_HOST,
						port: SMTP_PORT,
						startTls: true,
						credentials: { username: INBOX, password: appPassword },
						authType: ["plain", "login"],
					},
					{
						// Gmail rewrites the envelope sender to the authenticated
						// mailbox regardless, so send as the mailbox itself.
						from: { name: "Story & Measure website", email: INBOX },
						to: INBOX,
						reply: { name, email },
						subject,
						text: lines.join("\n"),
					},
				);
				formStatus = "success";
				formMessage = SUCCESS_MESSAGE;
			}
		}
	} catch (error) {
		// The submission is lost once this response is sent, so point the
		// visitor at the inbox rather than leaving them with a dead end.
		console.error("[contact] submission failed:", error);
		formStatus = "error";
		formMessage = `Sorry -- the message could not be sent. Please email ${INBOX} directly.`;
	}
}

const pageContent = page?.data.content;
---

<Base
	title="Contact"
	description="Tell Jodi Esposito about your business and what you want marketing to do for it."
>
	{pageContent && <MarketingBlocks value={pageContent} />}

	<section class="contact-form-section section">
		<div class="container">
			<div class="contact-grid">
				<div class="contact-info">
					<h2>Talk to Jodi</h2>
					<p>Fill out the form and you'll hear back within one business day.</p>

					<div class="contact-methods">
						<div class="contact-method">
							<div class="icon-tile contact-icon">
								<Icon name="ph:envelope" aria-hidden="true" />
							</div>
							<div class="contact-method-content">
								<h4>Email</h4>
								<a href="mailto:hello@storyandmeasure.com">hello@storyandmeasure.com</a>
							</div>
						</div>
					</div>
				</div>

				<div class="contact-form-wrapper">
					{
						formStatus === "success" ? (
							<div class="form-success">
								<div class="success-icon">✓</div>
								<h3>Message Sent!</h3>
								<p>{formMessage}</p>
								<a href="/contact" class="btn btn-secondary">
									Send another message
								</a>
							</div>
						) : (
							<form method="POST" class="contact-form">
								{formStatus === "error" && (
									<div class="form-error">
										<p>{formMessage}</p>
									</div>
								)}

								<div class="form-row">
									<div class="form-field">
										<label for="name">Name *</label>
										<input
											type="text"
											id="name"
											name="name"
											required
											placeholder="Your name"
											autocomplete="name"
										/>
									</div>
									<div class="form-field">
										<label for="email">Email *</label>
										<input
											type="email"
											id="email"
											name="email"
											required
											placeholder="you@company.com"
											autocomplete="email"
										/>
									</div>
								</div>

								<div class="form-field">
									<label for="company">Company</label>
									<input
										type="text"
										id="company"
										name="company"
										placeholder="Your company"
										autocomplete="organization"
									/>
								</div>

								<div class="form-field">
									<label for="message">Message *</label>
									<textarea
										id="message"
										name="message"
										required
										rows="5"
										placeholder="Tell us about your project or question..."
									/>
								</div>

								{/* Honeypot -- hidden from people and assistive tech, but
								    present in the DOM for form-filling bots. */}
								<div class="form-trap" aria-hidden="true">
									<label for="website">Website</label>
									<input
										type="text"
										id="website"
										name="website"
										tabindex="-1"
										autocomplete="off"
									/>
								</div>

								<button type="submit" class="btn btn-primary btn-lg">
									Send Message
								</button>
							</form>
						)
					}
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.contact-form-section {
		padding-bottom: var(--spacing-5xl);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.contact-info h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-md);
	}

	.contact-info > p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-2xl);
	}

	.contact-methods {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
	}

	.contact-method {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	.contact-icon {
		font-size: 1.25rem;
	}

	.contact-method-content h4 {
		font-size: var(--font-size-sm);
		font-weight: 600;
		margin-bottom: var(--spacing-xs);
	}

	.contact-method-content a {
		color: var(--color-brand);
		font-size: var(--font-size-lg);
	}

	.contact-method-content a:hover {
		text-decoration: underline;
	}

	.contact-form-wrapper {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-2xl);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
	}

	/* Honeypot. `display: none` is the one thing bots do check for, so take it
	   out of flow instead -- invisible to people, still submitted. */
	.form-trap {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-lg);
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.form-field label {
		font-size: var(--font-size-sm);
		font-weight: 500;
	}

	.form-field input,
	.form-field textarea {
		padding: var(--spacing-md);
		font-family: inherit;
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		transition:
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.form-field input:focus,
	.form-field textarea:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.form-field input::placeholder,
	.form-field textarea::placeholder {
		color: var(--color-muted);
	}

	.form-field textarea {
		resize: vertical;
		min-height: 120px;
	}

	.form-error {
		padding: var(--spacing-md);
		background: color-mix(in srgb, var(--color-danger) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-danger) 30%, transparent);
		border-radius: var(--radius-sm);
		color: var(--color-danger);
		font-size: var(--font-size-sm);
	}

	.form-success {
		text-align: center;
		padding: var(--spacing-2xl);
	}

	.success-icon {
		width: 64px;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		color: var(--color-on-brand);
		background: var(--color-success);
		border-radius: var(--radius-full);
		margin: 0 auto var(--spacing-lg);
	}

	.form-success h3 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-sm);
	}

	.form-success p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}

	@media (max-width: 768px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}

		.form-row {
			grid-template-columns: 1fr;
		}
	}
</style>
