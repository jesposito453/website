{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "storyandmeasure",
	"main": "./src/worker.ts",
	"workers_dev": true,
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Pages render at /<slug> (src/pages/[slug].astro), not the EmDash default
	// of /<collection>/<slug> -- this makes the admin's preview links match.
	"vars": {
		"EMDASH_PREVIEW_PATH_PATTERN": "/{id}",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "storyandmeasure-db",
			"database_id": "e76ef50e-b17a-42d6-a59f-79b7071469c9",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "storyandmeasure-media",
		},
	],
	// Contact form notifications go out over Gmail SMTP (see
	// src/pages/contact.astro). Cloudflare Email Sending would need the
	// Workers Paid plan; Workspace already authenticates this domain.
	// The app password lives in the GMAIL_APP_PASSWORD secret, never here.
	// Worker Loader for plugin sandboxing
	// "worker_loaders": [
	// 	{
	// 		"binding": "LOADER",
	// 	},
	// ],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"routes": [
		{
			"pattern": "storyandmeasure.com",
			"custom_domain": true,
		},
		{
			"pattern": "www.storyandmeasure.com",
			"custom_domain": true,
		},
	],
	"triggers": {
		"crons": ["* * * * *"],
	},
}
